# Copie para .env (local) e cadastre as mesmas variáveis na Vercel
# (Project → Settings → Environment Variables).

# ── Meta / WhatsApp Cloud API ─────────────────────────────────────────────
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# String inventada por você, igual à cadastrada no webhook do painel da Meta
VERIFY_TOKEN=
# App Settings → Basic → App Secret. Sem ele o webhook recusa tudo.
APP_SECRET=
GRAPH_API_VERSION=v21.0

# ── Dono ──────────────────────────────────────────────────────────────────
# Seu número com DDI e DDD, só dígitos. Só ele conversa com o agente.
DONO_WHATSAPP=5581999999999
DONO_NOME=Artur

# ── IA ────────────────────────────────────────────────────────────────────
# Custo zero: Gemini (conversa) + Groq (transcrição). Qualquer provedor no
# formato da OpenAI serve; sem *_BASE_URL, usa a OpenAI com OPENAI_API_KEY.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODELO=gemini-3.5-flash-lite
LLM_MODELOS_RESERVA=gemini-flash-lite-latest,gemini-3.8-flash,gemini-flash-latest
# LLM_ESFORCO=low

TRANSCRICAO_BASE_URL=https://api.groq.com/openai/v1
TRANSCRICAO_API_KEY=
TRANSCRICAO_MODELO=whisper-large-v3-turbo

# Figurinha gerada do zero (opcional, pago). Sem chave, essa função fica desligada.
# IMAGEM_API_KEY=
# IMAGEM_MODELO=gpt-image-1-mini

# ── Supabase ──────────────────────────────────────────────────────────────
# Connect → Transaction pooler (porta 6543)
DATABASE_URL=

# ── Lembretes ─────────────────────────────────────────────────────────────
# URL do deploy na Vercel (usada pelo npm run db:setup)
APP_URL=https://seu-projeto.vercel.app
# Senha longa e aleatória; o pg_cron usa para chamar /api/tick
CRON_SECRET=
# Template aprovado para lembretes fora da janela de 24h (npm run template)
LEMBRETE_TEMPLATE=lembrete
LEMBRETE_TEMPLATE_IDIOMA=pt_BR

# ── Transcrição de links (opcional) ───────────────────────────────────────
# Cookies em formato Netscape, quando YouTube/Instagram bloquearem o servidor.
# YTDLP_COOKIES=
