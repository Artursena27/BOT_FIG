{
  "name": "agente-whatsapp",
  "version": "3.0.0",
  "private": true,
  "description": "Agente pessoal no WhatsApp (Meta Cloud API + OpenAI), rodando na Vercel",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/baixar-ytdlp.js",
